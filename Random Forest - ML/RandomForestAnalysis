def scan_directory(path):
    py_files_count = 0
    nb_files_count = 0
    
    for root, dirs, files in os.walk(path):
        for file in files:
            if file.endswith(".py"):
                py_files_count += 1
                # Further Python file analysis could be added here
            elif file.endswith(".ipynb"):
                nb_files_count += 1
                nb_path = os.path.join(root, file)
                nb_analysis(nb_path)
                
    print(f"Python files: {py_files_count}, Jupyter Notebooks: {nb_files_count}")

global_summaries = []

def nb_analysis(nb_path):
    """Analyzes Jupyter Notebook and generates summaries for code and markdown cells."""
    try:
        with open(nb_path, 'r', encoding='utf-8') as f:
            nb = nbformat.read(f, as_version=4)
            local_summaries = []  # Store summaries for the current notebook

            for i, cell in enumerate(nb['cells']):
                if cell['cell_type'] in ['code', 'markdown']:
                    content = cell['source']
                    if content.strip():  # Ensure cell is not empty
                        # Generate summary for the cell
                        inputs = tokenizer.encode_plus(content, return_tensors="pt", max_length=1024, truncation=True, padding="max_length")
                        outputs = model.generate(
                            input_ids=inputs['input_ids'],
                            attention_mask=inputs['attention_mask'],
                            max_length=1024, 
                            temperature=0.5,  
                            top_p=0.9, 
                            top_k=70,
                            num_return_sequences=1,
                            do_sample=True # Enable sampling-based generation
                        )
                        summary = tokenizer.decode(outputs[0], skip_special_tokens=True)
                        # Append summary in structured format
                        local_summaries.append({
                            "type": cell['cell_type'],
                            "index": i + 1,
                            "summary": summary
                        })

            global_summaries.extend(local_summaries)  # Add local summaries to global list
            print(f"Processed {len(local_summaries)} cells from notebook: {nb_path}")
    except Exception as e:
        print(f"Error processing notebook {nb_path}: {e}")

