])
nn.compile(optimizer=Adam(config.learning_rate_nn), loss='categorical_crossentropy')

# Train the neural network
nn.fit(X_train, y_train_enc, epochs=config.epochs_nn, batch_size=config.batch_size_nn, validation_split=0.1)

# Evaluate models
