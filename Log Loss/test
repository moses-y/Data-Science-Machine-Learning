from pydantic import BaseModel

class Config(BaseModel):
    n_estimators: int = 158
    random_state_rf: int = 40
    random_state_et: int = 42
    max_iter_lg: int = 150
    epochs_nn: int = 100
    batch_size_nn: int = 32
    learning_rate_nn: float = 0.0001
    dropout_rate: float = 0.2
    dense_layer_sizes: list = [300, 200, 100]
    regularization_l1: float = 0.1
    optimizer_nn: str = 'adam'
    noise_stddev: float = 0.01
    k_neighbors: int = 5
    num_leaves: int = 66
    feature_fraction: float = 0.61
    bagging_fraction: float = 0.54
    bagging_freq: int = 2
    learning_rate_lgbm: float = 0.055
    n_trials_optuna: int = 30

config = Config()


